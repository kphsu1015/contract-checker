# OpenAI
OPENAI_API_KEY=sk-...
# 選填，預設 gpt-5.5
OPENAI_MODEL=gpt-5.5

# MongoDB 連線字串
MONGODB_URI=mongodb+srv://...

# Vercel Blob 讀寫 token（本機開發必填；部署到 Vercel 時會自動注入）
# 取得方式：Vercel 專案 > Storage > 建立 Blob store > .env.local 頁籤
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# 會員登入用的 JWT 簽章密鑰，用亂數字串即可，例如：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=...
